# Environment for a private, offline Proposal Studio + Ollama. Read by start.ps1 and start.sh.
# Ollama names verified against `ollama serve --help` (vibes/DECISIONS.md).

# --- Ollama: one model at a time on a 16 GB laptop; no cloud features ---
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NO_CLOUD=1
# --- No telemetry from any Python library ---
HF_HUB_OFFLINE=1
DO_NOT_TRACK=true
