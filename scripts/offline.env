# Environment for an offline, private Open WebUI + Ollama. Read by start.ps1 and start.sh.
# Names verified against open-webui 0.13.0 and `ollama serve --help` (vibes/DECISIONS.md).
# Values here are applied on every start (ENABLE_PERSISTENT_CONFIG=False keeps env authoritative).

# --- Open WebUI: offline, no telemetry, no external services ---
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
ENABLE_PERSISTENT_CONFIG=False
ENABLE_VERSION_UPDATE_CHECK=False
ENABLE_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
ENABLE_COMMUNITY_SHARING=False
ENABLE_OPENAI_API=False
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_OTEL=False
ANONYMIZED_TELEMETRY=False
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
# --- Ollama as the only model backend; its embeddings for Open WebUI's own RAG ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Put RAG context in the system message, never in front of the user's /command
RAG_SYSTEM_CONTEXT=True
# --- Background "task" generations would call the Proposal Studio model: off (CPU) ---
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_SEARCH_QUERY_GENERATION=False
ENABLE_RETRIEVAL_QUERY_GENERATION=False
ENABLE_AUTOCOMPLETE_GENERATION=False
# --- Ollama: one model at a time on a 16 GB laptop; no cloud features ---
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NO_CLOUD=1
